# Operating System & IDE Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Node / NPM / Package Managers (if added in the future)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Logs & Temporary Files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# Archives and build bundles
*.zip
*.tar.gz
*.rar
